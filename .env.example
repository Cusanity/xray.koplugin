# X-Ray Generator Configuration
# Copy this file to .env and fill in your values.

# OpenAI-compatible API endpoint
XRAY_API_BASE=http://localhost:8080/v1
XRAY_API_KEY=your-api-key-here
XRAY_MODEL=gemini-2.5-flash-lite

# Anthropic Claude (optional)
CLAUDE_API_KEY=

# Google Gemini (optional)
GEMINI_API_KEY=

# DeepSeek (optional)
DEEPSEEK_API_KEY=

# Calibre library path (required for --browse mode)
CALIBRE_LIBRARY=/path/to/your/Calibre Library

# X-Ray output folder (optional, defaults to <app folder>/xray)
# XRAY_OUTPUT_DIR=/path/to/xray/output
